    "db:migrate:local": "wrangler d1 migrations apply health-tracker-beta-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply health-tracker-beta-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}